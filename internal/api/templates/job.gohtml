{{define "content"}}
{{$d := .Data}}
{{$job := $d.Job}}
<div class="page-head">
  <div>
    <h1>{{$job.WorkflowType}} <span class="pill {{statusClass $job.Status}}"><span class="sdot"></span>{{statusLabel $job.Status}}</span></h1>
    <p class="subtitle mono">{{$job.ID}}</p>
  </div>
  <div class="actions">
    {{if $d.CanRetry}}
    <form method="post" action="/ui/jobs/{{$job.ID}}/retry"><button class="btn" type="submit">Retry</button></form>
    {{end}}
    <form method="post" action="/ui/jobs/{{$job.ID}}/replay"><button class="btn" type="submit">Replay</button></form>
    {{if $d.CanCancel}}
    <form method="post" action="/ui/jobs/{{$job.ID}}/cancel"><button class="btn btn-danger" type="submit">Cancel</button></form>
    {{end}}
  </div>
</div>

{{with deref $job.Error}}
<div class="callout"><span class="k">Error</span>{{.}}</div>
{{end}}

<section>
  <div class="card meta-grid">
    <div class="meta-cell"><div class="k">Queue</div><div class="v">{{$job.Queue}}</div></div>
    <div class="meta-cell"><div class="k">Attempts</div><div class="v">{{$job.Attempt}} of {{$job.MaxAttempts}}</div></div>
    <div class="meta-cell"><div class="k">Created</div><div class="v" title="{{rfc3339 $job.CreatedAt}}">{{timeago $job.CreatedAt}}</div></div>
    <div class="meta-cell"><div class="k">Updated</div><div class="v" title="{{rfc3339 $job.UpdatedAt}}">{{timeago $job.UpdatedAt}}</div></div>
    {{if isParked $job}}<div class="meta-cell"><div class="k">Parked until</div><div class="v" title="{{rfc3339 $job.RunAfter}}">{{timeago $job.RunAfter}}</div></div>{{end}}
    {{if $job.LeaseOwner}}<div class="meta-cell"><div class="k">Worker</div><div class="v">{{$job.LeaseOwner}}</div></div>{{end}}
    {{if $job.IdempotencyKey}}<div class="meta-cell"><div class="k">Idempotency key</div><div class="v mono">{{$job.IdempotencyKey}}</div></div>{{end}}
    {{with $d.Parent}}<div class="meta-cell"><div class="k">Parent</div><div class="v"><a class="id-link mono" href="/ui/jobs/{{.ID}}">{{.WorkflowType}} · {{shortID .ID}}</a></div></div>{{end}}
  </div>
</section>

{{if $d.Timeline}}
<section>
  <h2>Execution path</h2>
  <div class="card">
    {{range $d.Timeline}}
    <div class="tl-row">
      <span class="tl-check {{.Class}}">●</span>
      <div class="tl-body">
        <span class="tl-name">{{.Title}}</span>{{if .Link}} <a class="id-link mono" href="{{.Link}}">{{.LinkText}}</a>{{end}}{{if .Badge}} <span class="pill st-failed"><span class="sdot"></span>{{.Badge}}</span>{{end}}
        {{if .Text}}<div>{{.Text}}</div>{{end}}
        {{if .Data}}<details><summary>Data</summary><pre class="json">{{prettyJSON .Data}}</pre></details>{{end}}
      </div>
      <span class="tl-when" title="{{rfc3339 .At}}">{{timeago .At}}</span>
    </div>
    {{end}}
  </div>
</section>
{{end}}

<section>
  <h2>Send signal</h2>
  <div class="card">
    <form method="post" action="/ui/jobs/{{$job.ID}}/signal" class="filters">
      <input name="name" placeholder="signal name" required>
      <input name="payload" placeholder='payload JSON, e.g. {"ok":true}' value="{}">
      <button class="btn" type="submit">Send</button>
    </form>
  </div>
</section>

<section>
  <h2>Payload</h2>
  <div class="card"><pre class="json">{{prettyJSON $job.Payload}}</pre></div>
</section>

{{if $job.Result}}
<section>
  <h2>Result</h2>
  <div class="card"><pre class="json">{{prettyJSON $job.Result}}</pre></div>
</section>
{{end}}

<section>
  <h2>History</h2>
  <div class="card">
    {{if $d.Events}}
    <table>
      <thead><tr><th>Event</th><th>Details</th><th>When</th></tr></thead>
      <tbody>
        {{range $d.Events}}
        {{$t := .EventType}}
        <tr>
          <td>{{with eventClass $t}}<span class="pill {{.}}"><span class="sdot"></span>{{$t}}</span>{{else}}{{$t}}{{end}}{{if isPermanent .Details}} <span class="pill st-failed"><span class="sdot"></span>permanent</span>{{end}}</td>
          <td class="mono">{{compactJSON .Details}}</td>
          <td class="when" title="{{rfc3339 .CreatedAt}}">{{timeago .CreatedAt}}</td>
        </tr>
        {{end}}
      </tbody>
    </table>
    {{else}}
    <div class="empty">No events recorded.</div>
    {{end}}
  </div>
</section>
{{end}}
