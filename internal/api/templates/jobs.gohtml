{{define "content"}}
{{$d := .Data}}
<h1>{{if eq $d.Status "dead_letter"}}Dead letters{{else}}Jobs{{end}}</h1>
<p class="subtitle" data-poll="count">{{len $d.Jobs}} shown, newest first, updating live.</p>

<form class="filters" method="get" action="/ui/jobs">
  <input type="text" name="queue" placeholder="Queue" value="{{$d.Queue}}">
  <select name="status">
    <option value="">Any status</option>
    {{range $d.Statuses}}
    <option value="{{.}}" {{if eq $d.Status .}}selected{{end}}>{{statusLabel .}}</option>
    {{end}}
  </select>
  <input type="text" name="type" placeholder="Workflow type" value="{{$d.Type}}">
  <button class="btn" type="submit">Filter</button>
</form>

<div class="card" data-poll="jobs">
  {{if $d.Jobs}}
  {{template "jobtable" $d.Jobs}}
  {{else}}
  <div class="empty">No jobs match these filters.</div>
  {{end}}
</div>

{{if or $d.LatestURL $d.OlderURL}}
<div class="pager">
  {{if $d.LatestURL}}<a class="btn" href="{{$d.LatestURL}}">← Latest</a>{{end}}
  <span class="spacer"></span>
  {{if $d.OlderURL}}<a class="btn" href="{{$d.OlderURL}}">Older →</a>{{end}}
</div>
{{end}}
{{end}}
